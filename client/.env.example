# Which API `npm run dev:client` talks to. Copy to .env.local.
# Deployed API (default once deployed): the Vercel URL of this project.
API_PROXY_TARGET=https://sariel-app.vercel.app
# Local API instead (run `npm run dev:api` too):
# API_PROXY_TARGET=http://127.0.0.1:9149

# Public HTTPS or root-relative release APK URL. Leave empty until the APK is published.
VITE_ANDROID_APK_URL=
