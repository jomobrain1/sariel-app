# Server
PORT=9149

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sariel_app_api

# Authentication - use private values from .env
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=

# Cloudinary (backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET_KEY=

# Password recovery (backend only)
MAIL_USER=
MAIL_PASS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465

AUTH_COOKIE_SESSION=true

# Tenant workspaces
# Fill the Super Admin values before running npm run tenancy:setup.
TENANCY_BASE_DOMAIN=localhost
TENANCY_SUPERADMIN_EMAIL=
TENANCY_SUPERADMIN_PASSWORD=

# Verification relay: receives authenticated HTTPS POSTs with channel, target, code.
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=

# AI providers (optional: keys can also be entered by the superadmin under Settings → AI providers)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# 32-byte key (64 hex characters) used to encrypt stored secrets such as provider keys.
# If unset, a key is derived from AUTH_ACCESS_SECRET (rotating that secret then makes stored keys unreadable).
SARIEL_DATA_KEY=

# Notification delivery webhook for email/SMS (see api/src/notifications/engine.ts)
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=
